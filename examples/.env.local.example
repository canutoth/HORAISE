# === Google Sheets ===
GOOGLE_SHEETS_ID=your_google_sheet_id
# Aba principal de membros: Nome, Apelido, Email, Bolsa, Frentes, Editor,
# Pending-Access, Pending-TimeTable, Pending-Suggestion, HP, HO
# + 91 colunas de horário Seg7-8..Dom19-20 — veja examples/sheet-info.example.csv
SHEET_NAME=INFO
# Aba de regras dinâmicas (Regra, Valor) — veja examples/sheet-rules.example.csv
RULES_SHEET_NAME=RULES
# Referência de frentes/bolsas (Frentes, Emoji-Frente, Bolsa, Cor-Bolsa)
# — veja examples/sheet-backlog.example.csv
BACKLOG_SHEET_NAME=BACKLOG
# Aba de horários sugeridos pelo admin (Email + 91 colunas). Criada
# automaticamente na primeira sugestão, se ainda não existir.
SUGGESTED_SHEET_NAME=SUGGESTED

# === Conta de serviço do Google Sheets ===
GOOGLE_CLIENT_EMAIL=your_google_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"

# === Login com Google (Google OAuth) ===
# Crie uma credencial "Web application" em https://console.cloud.google.com/apis/credentials
# e adicione o GOOGLE_REDIRECT_URI abaixo como Authorized redirect URI.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Em produção: https://hora.aiselab.com.br/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# === Admin ===
# Email do administrador (recebe as notificações de cadastro/solicitações)
EMAIL_ADMIN="admin@example.com"

# === SMTP (envio de emails) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=email.para.enviar.emails@gmail.com
# Gere uma senha de app em: https://myaccount.google.com/apppasswords
SMTP_PASS=sua_senha_de_app_gerada

# === URL base para os links nos emails ===
NEXT_PUBLIC_BASE_URL=http://localhost:3001